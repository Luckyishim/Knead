<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- Change Data Source, Initial Catalog, User ID, and Password to match your SQL Server instance -->
		<add name="KneadDB"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KneadDB;
		 Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxRequestLength="1048576" />
		<customErrors mode="Off" />
		<sessionState timeout="120" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
		<pages styleSheetTheme="">
			<controls>
				<add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			</controls>
		</pages>
	</system.web>

	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
				<add value="Home.aspx" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>
