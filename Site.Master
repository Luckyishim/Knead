<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="KneadLMS.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>knead. Culinary LMS - Learn What You Need, One Cuisine at a Time</title>
    <link rel="stylesheet" href="styles/shared.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Dynamic Header / Navbar -->
        <header class="site-header scrolled">
            <div class="navBar">
                <a href="Default.aspx" class="logo">
                    <div class="logo-icon">k.</div>
                    <div class="logo-text">
                        <h4>knead<span>.</span></h4>
                        <p>CULINARY LMS</p>
                    </div>
                </a>

                <div class="nav-links">
                    <a class="nav-link <%= GetNavActiveClass("Default.aspx") %>" href="Default.aspx">Home</a>
                    <a class="nav-link <%= GetNavActiveClass("ItemList.aspx") %>" href="ItemList.aspx">Cuisines</a>
                    <a class="nav-link <%= GetNavActiveClass("Quizzes.aspx") %>" href="Quizzes.aspx">Quizzes</a>
                    <a class="nav-link <%= GetNavActiveClass("Forums.aspx") %>" href="Forums.aspx">Forum</a>
                    <a class="nav-link <%= GetNavActiveClass("About.aspx") %>" href="About.aspx">About</a>
                </div>

                <div class="nav-actions">
                    <asp:Panel ID="pnlGuest" runat="server">
                        <a href="Login.aspx" class="login-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            Login / Signup
                        </a>
                    </asp:Panel>

                    <asp:Panel ID="pnlUser" runat="server" Visible="false" Style="display: flex; align-items: center; gap: 12px;">
                        <asp:HyperLink ID="lnkUserProfile" runat="server" NavigateUrl="UserDashboard.aspx" Style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text-main); font-weight: 600; font-size: 14px;">
                            <div class="user-avatar" style="width: 32px; height: 32px; font-size: 14px; background: var(--primary-orange); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                <asp:Literal ID="litUserInitials" runat="server">U</asp:Literal>
                            </div>
                            <asp:Literal ID="litUserName" runat="server">User</asp:Literal>
                        </asp:HyperLink>

                        <a href="Logout.aspx" class="btn-action-outline" style="padding: 6px 12px; font-size: 12px; text-decoration: none; color: #DC2626; border-color: #FCA5A5;">Logout</a>
                    </asp:Panel>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Site Footer -->
        <footer class="site-footer">
            <div class="footer-container">
                <a href="Default.aspx" class="logo">
                    <div class="logo-icon">k.</div>
                    <div class="logo-text">
                        <h4>knead<span>.</span></h4>
                        <p>CULINARY LMS</p>
                    </div>
                </a>

                <nav class="footer-nav">
                    <a href="ItemList.aspx">Cuisines</a>
                    <a href="Quizzes.aspx">Quizzes</a>
                    <a href="Forums.aspx">Forum</a>
                    <a href="About.aspx">About Us</a>
                    <a href="About.aspx#contact">Contact Us</a>
                </nav>
            </div>

            <div class="footer-bottom">
                <p>© 2026 Knead Culinary LMS. All rights reserved.</p>
            </div>
        </footer>
    </form>

    <script src="script.js"></script>
</body>
</html>
