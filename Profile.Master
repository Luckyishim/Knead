<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Profile.Master.cs" Inherits="KneadLMS.ProfileMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Member Portal - knead. Culinary LMS</title>
    <link rel="stylesheet" href="styles/shared.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body style="background-color: #FFFFFF; margin: 0; padding: 0;">
    <form id="formProfile" runat="server">
        <!-- Top Minimal Header (Minimal Header with Back Button & Centered Logo - No Main Navbar) -->
        <div class="quiz-top-bar" style="background: #FFFFFF; border-bottom: 1px solid var(--border-light); padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100;">
            <a href="<%= GetBackUrl() %>" class="quiz-back-btn" title="Back" style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #F5EFEB; color: #1C1917; text-decoration: none; transition: background 0.2s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
            </a>

            <a href="Default.aspx" class="logo" title="Back to Home" style="gap: 8px; text-decoration: none;">
                <div class="logo-icon" style="width: 34px; height: 34px; font-size: 18px;">k.</div>
                <span class="logo-text">
                    <h4 style="font-size: 20px; margin: 0;">knead<span>.</span></h4>
                </span>
            </a>

            <div style="width: 40px;"></div>
        </div>

        <!-- Main Content Area -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </form>

    <script src="script.js"></script>
</body>
</html>
